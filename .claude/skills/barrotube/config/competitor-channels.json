  "channel_id_resolution": {
    "cache_file": "workspace/intel/competitors/channel-id-cache.json",
    "manual_overrides_file": "config/competitor-channel-overrides.json",
    "youtube_search_when_miss": false,
    "search_max_results": 3,
    "search_region_code": "KR",
    "search_relevance_language": "ko"
  },
  "tracking": {
    "fields": [
      "subscriberCount",
      "videoCount",
      "viewCount"
    ],
    "uploads_page_size": 50,
    "recent_videos_window_days": 7,
    "recent_videos_per_channel": 50,
    "refresh_window_days": 14,
    "baseline_window_days": 90,
    "stats_history_max": 30,
    "deep_scan_pages": 4,
    "scan_times_kst": [
      "05:20",
      "15:20"
    ],
    "scan_times_note": "두 브리핑 슬롯(us-close 06:00 / kr-close 16:00) 40분 전에 각각 돈다. 설치: bash lib/install-cron.sh install competitor-scan \"05:20,15:20\""
  },
  "quota": {
    "daily_cap_units": 2000,
    "units": {
      "channels.list": 1,
      "playlistItems.list": 1,
      "videos.list": 1
    },
    "note": "무료 10,000/day 중 발행 경로(videos.insert 1600 + thumbnails.set 50 + playlistItems.insert 50 ≈ 1700/편)를 보호하기 위해 인텔 수집은 2000으로 자체 제한한다. 정상 운영은 채널당 3 units × 6채널 × 하루 2회 = 36, 주 1회 deep scan 54 를 더해도 일 평균 44 수준이라 이 상한에 닿지 않는다."
  },
  "discovery": {
    "enabled": false,
    "source_dir": "workspace/intel/marketing",
    "max_reports": 3,
    "max_age_days": 30,
    "output": "workspace/intel/competitors/suggested-channels.json",
    "note": "v2.0 정규식 추출기를 제안 전용으로 보존. 여기서 나온 결과는 수집 대상이 되지 않으며, 운영자가 channels[] 에 직접 옮겨야 반영된다.",
    "channel_name_patterns": [
      {
        "type": "h3_section",
        "regex": "^###\\s*채널\\s*\\d+\\s*:\\s*([^\\n(]+?)\\s*(?:\\(|$)",
        "comment": "예: ### 채널 1: 슈카월드 (대표 벤치마크)"
      },
      {
        "type": "h2_section",
        "regex": "^##\\s*채널\\s*\\d+\\s*:\\s*([^\\n(]+?)\\s*(?:\\(|$)"
      },
      {
        "type": "table_row",
        "regex": "^\\|\\s*\\d+\\s*\\|\\s*([^|]+?)\\s*\\|",
        "comment": "예: | 1 | 슈카월드 | 360만 |"
      }
    ],
    "exclude_names": [
      "채널명",
      "구독자",
      "비고",
      "BarroTube"
    ],
    "min_name_length": 2,
    "max_name_length": 30
  },
  "operator_notes": {
    "add_channel": "channels[] 에 항목 추가. channelId 를 모르면 null 로 두고 handle 만 적은 뒤 resolve-competitor-channels.js --resolve-handles 실행(1 unit).",
    "remove_channel": "배열에서 삭제하지 말고 active:false 로 둘 것. 제거하면 과거 분석의 baseline 모집단이 깨진다.",
    "manual_overrides": "config/competitor-channel-overrides.json 에 {\"<채널명>\": \"UC...\"} 를 넣으면 channels[].channelId 보다 우선 적용된다. 채널명이 바뀌었거나 매핑이 틀렸을 때 사용.",
    "cache_invalidation": "channel-id-cache.json 에서 해당 entry 삭제 → 다음 실행 시 재해석."
  },
  "stance_legend": {
    "bullish-lean": "상승·매수 실행 프레임이 강함",
    "bearish-lean": "하락·조정 경고 프레임이 강함",
    "neutral": "통계·정책 원문 중심",
    "data-driven": "자체 지표·데이터 중심",
    "mixed": "게스트/주제에 따라 갈림",
    "analyst": "애널리스트 화법",
    "macro": "거시연결",
    "tax": "세제",
    "auction": "경매",
    "narrative": "서사형",
    "general": "부동산 비전문 종합"
  }
}