      "default_persona": "barro-alert",
      "duration": {
        "target_seconds": 172,
        "tolerance_seconds": 3,
        "qa_accept_range": [
          174,
          180
        ]
      },
      "scene_count": 7,
      "scene_length_seconds": {
        "min": 15,
        "max": 30
      },
      "canvas": {
        "width": 1080,
        "height": 1920,
        "ratio": "9:16"
      },
      "style_guide_path": "workspace/channels/{channel}/style-guide-shorts.md",
      "metadata": {
        "shorts_tag": true,
        "description_suffix": "#Shorts",
        "auto_hashtags": [
          "#Shorts",
          "#경제",
          "#증시",
          "#3분경제",
          "#투자",
          "#BarroTube"
        ]
      },
      "pipeline": {
        "skip_stages": [],
        "script_prompt_variant": "shorts_7scene_172s",
        "asset_generation_count": 7,
        "mid_hook_required_at_seconds": 75
      },
      "budget_profile_ref": "long-3min"
    },
    {
      "id": "long-3min",
      "display_name": "롱폼 3분 시리즈",
      "description": "체계적 교육 커리큘럼 (S&P500 입문 등). 16:9 가로, 시청 지속시간 최적화.",
      "default_persona": "barro-teacher",
      "duration": {
        "target_seconds": 180,
        "tolerance_seconds": 10,
        "qa_accept_range": [
          170,
          190
        ]
      },
      "scene_count": 7,
      "scene_length_seconds": {
        "min": 10,
        "max": 40
      },
      "canvas": {
        "width": 1920,
        "height": 1080,
        "ratio": "16:9"
      },
      "style_guide_path": "workspace/channels/{channel}/style-guide-long.md",
      "metadata": {
        "shorts_tag": false,
        "description_suffix": ""
