      "default_persona": "barro-alert",
      "duration": {
        "target_seconds": 60,
        "tolerance_seconds": 2,
        "qa_accept_range": [
          58,
          62
        ]
      },
      "scene_count": 5,
      "scene_length_seconds": {
        "min": 10,
        "max": 14
      },
      "canvas": {
        "width": 1080,
        "height": 1920,
        "ratio": "9:16"
      },
      "style_guide_path": "workspace/channels/{channel}/style-guide-shorts.md",
      "metadata": {
        "shorts_tag": true,
        "description_suffix": "#Shorts",
        "auto_hashtags": [
          "#Shorts",
          "#경제",
          "#경제기초",
          "#3분경제",
          "#투자",
          "#BarroTube",
          "#경제공부"
        ],
        "auto_hashtags_note": "S9 Metadata 단계에서 자동 적용. 에피소드별 시리즈 키워드는 series.json source.blue_ocean_keywords에서 추가 병합."
      },
      "pipeline": {
        "skip_stages": [],
        "script_prompt_variant": "shorts_5scene_60s",
        "asset_generation_count": 5,
        "skip_stages_note": "S2/S3 는 건너뛰지 않는다. auto-pipeline.sh 가 research-brief.js 산출물을 모든 슬롯에 대해 10_market_research.md / 20_strategy.md 로 설치하며(실패 시 중단), 그 문서가 경쟁 인텔이 대본까지 전파되는 통로다. 구 설정 ['S2_market_research', 'S3_strategy'] 은 실제 동작과 어긋나 제거했다 (2026-08-13)."
      },
      "budget_profile_ref": "shorts"
    },
    {
      "id": "shorts-3min",
      "display_name": "Shorts 3min",
