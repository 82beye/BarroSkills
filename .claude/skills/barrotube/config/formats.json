    "max_derive_count_per_parent": 2,
    "derive_timing": "parent_publish_plus_3_hours",
    "persona_switch_required": true,
    "parent_tracking_field": "parent_ticket_id",
    "budget_reuse": true,
    "description": "롱폼 발행 +3시간 후 파생 Shorts 1편 자동 생성. 톤은 barro-alert로 전환. 이미지 재활용으로 비용 절감."
  },
  "channel_format_mapping": {
    "econ-daily": {
      "enabled_formats": [
        "shorts",
        "shorts-3min",
        "long-3min"
      ],
      "weekly_schedule": {
        "shorts": {
          "cadence": "daily",
          "slots_per_week": 7,
          "time_kst": "11:30",
          "note": "매일 오전 11:30 업로드 (재고 있을 때). 롱폼 파생 + 전용 Shorts 혼합. CMO 확정 2026-04-28 YOU-103 기반."
        },
        "long-3min": {
          "cadence": "tue_thu",
          "slots_per_week": 2,
          "time_kst": "07:00",
          "note": "화·목 오전 07:00 업로드. CMO 확정 2026-04-28 YOU-103 기반."
        }
      }
    }
  }
